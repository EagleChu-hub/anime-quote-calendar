{
  "version": "1.0",
  "canvas": { "width": 1080, "height": 1920 },
  "scene": {
    "note": "全版風景：風景區即整張卡。scenes.json 的 y 以卡片頂端為 0、底端為 1；x 為元素水平中心；width 為元素寬佔卡寬比例。",
    "top": 0, "height": 1920,
    "horizonY": 0.62
  },
  "codeColors": {
    "#010101": "silhouette.far",
    "#020202": "silhouette.mid",
    "#030303": "silhouette.near",
    "#FEFEFE": "highlight",
    "#FFCC00": "light",
    "#FF0000": "accent"
  },
  "palettes": {
    "day": {
      "sky": { "top": "#1B4C86", "mid": "#5E97CF", "bottom": "#E4EBEA", "stops": [0, 0.42, 0.62] },
      "silhouette": { "far": "#93A3C0", "mid": "#3F5761", "near": "#18232A" },
      "highlight": "#F7F4EA", "light": "#FFD98A", "accent": "#D0533C",
      "text": { "primary": "#FFFFFF", "secondary": "rgba(255,255,255,0.85)", "tertiary": "rgba(255,255,255,0.7)" },
      "overlay": { "topScrim": 0.14, "vignette": 0.8 }
    },
    "dusk": {
      "sky": { "top": "#27336B", "mid": "#B87E97", "bottom": "#F7C08A", "stops": [0, 0.45, 0.63] },
      "silhouette": { "far": "#806C99", "mid": "#3E3650", "near": "#16131E" },
      "highlight": "#FFD6A8", "light": "#FFC468", "accent": "#E0603A",
      "text": { "primary": "#FFFFFF", "secondary": "rgba(255,255,255,0.85)", "tertiary": "rgba(255,255,255,0.7)" },
      "overlay": { "topScrim": 0.18, "vignette": 0.8 }
    },
    "night": {
      "sky": { "top": "#050A21", "mid": "#15204E", "bottom": "#3B3F70", "stops": [0, 0.45, 0.64] },
      "silhouette": { "far": "#2A3160", "mid": "#151A33", "near": "#06080F" },
      "highlight": "#AEBBDA", "light": "#FFD27A", "accent": "#A9463E",
      "text": { "primary": "#EEF0F8", "secondary": "rgba(238,240,248,0.85)", "tertiary": "rgba(238,240,248,0.7)" },
      "overlay": { "topScrim": 0.0, "vignette": 0.62 }
    },
    "rain": {
      "sky": { "top": "#56606C", "mid": "#7F8A95", "bottom": "#AEB5BC", "stops": [0, 0.45, 0.63] },
      "silhouette": { "far": "#7A8591", "mid": "#3E4A52", "near": "#1D252B" },
      "highlight": "#DDE2E6", "light": "#FFD78A", "accent": "#B04E3E",
      "text": { "primary": "#FFFFFF", "secondary": "rgba(255,255,255,0.87)", "tertiary": "rgba(255,255,255,0.72)" },
      "overlay": { "topScrim": 0.3, "vignette": 0.82 }
    }
  },
  "seasons": {
    "note": "季節微調：color = mix(原色, tint, amount)，只作用在 targets 列出的欄位。",
    "spring": { "tint": "#F4C6D2", "amount": 0.12, "targets": ["sky.bottom", "highlight"] },
    "summer": { "tint": "#FFFFFF", "amount": 0.0, "targets": [] },
    "autumn": { "tint": "#F2AE70", "amount": 0.12, "targets": ["sky.bottom", "highlight", "silhouette.far"] },
    "winter": { "tint": "#C8D6EC", "amount": 0.14, "targets": ["sky.bottom", "highlight", "silhouette.far"] }
  },
  "overlays": {
    "topScrim": { "color": "#040910", "y0": 0, "y1": 560, "note": "opacity 取 palettes[time].overlay.topScrim，由 y0 的 opacity 漸變到 y1 的 0" },
    "vignette": { "color": "#040910", "y0": 1050, "y1": 1920, "stops": [[0, 0], [0.3, 0.56], [1, 1]], "note": "每個 stop 的 alpha = stop 值 × palettes[time].overlay.vignette" },
    "grain": { "opacity": 0.06, "blend": "overlay", "baseFrequency": 0.9, "note": "可選：灰階雜訊覆蓋，增加底片感" }
  },
  "layout": {
    "padX": 90,
    "date": {
      "x": 90, "top": 110,
      "day": { "font": "Noto Sans TC", "weight": 200, "size": 200, "baselineFromTop": 170 },
      "meta": {
        "gapFromDay": 28,
        "line1": { "font": "Noto Sans TC", "weight": 500, "size": 28, "baselineFromTop": 124, "format": "YYYY.MM・星期X" },
        "line2": { "font": "Noto Sans TC", "weight": 400, "size": 28, "baselineFromTop": 164, "opacityKey": "secondary", "format": "{節日或節氣}・農曆{月日}；無節日時只顯示農曆" }
      }
    },
    "mark": {
      "text": "今日のセリフ", "font": "Zen Kaku Gothic New", "weight": 400, "size": 22, "letterSpacing": 2.6,
      "right": 990, "top": 120, "padding": [6, 12], "border": 1.5,
      "note": "以 Canvas 繪製文字與外框（不做成 SVG，以免需要轉外框）"
    },
    "quoteBlock": {
      "note": "由下往上堆疊：先量出各段高度，總高 H，起點 y = bottom − H。",
      "bottom": 1810, "maxWidth": 900,
      "quote": { "font": "Noto Sans TC", "weight": 500, "size": 56, "lineHeight": 84, "align": "center", "maxLines": 3, "fallbackSize": 50, "fallbackLineHeight": 76, "wrap": "balance" },
      "jp": { "font": "Zen Kaku Gothic New", "weight": 400, "size": 29, "lineHeight": 46, "align": "center", "gapTop": 18, "colorKey": "secondary" },
      "source": { "font": "Noto Sans TC", "weight": 400, "size": 25, "lineHeight": 40, "align": "center", "gapTop": 10, "colorKey": "tertiary" },
      "divider": { "width": 64, "height": 2, "gapTop": 40, "gapBottom": 36, "opacity": 0.5 },
      "essay": { "font": "Noto Sans TC", "weight": 300, "size": 30, "lineHeight": 55, "align": "left", "maxLines": 4, "opacity": 0.92 },
      "kinsoku": "，。、；：！？」』）…—"
    }
  },
  "fonts": [
    { "family": "Noto Sans TC", "weights": [200, 300, 400, 500], "use": "日期、台詞中譯、出處、短文", "license": "SIL Open Font License 1.1" },
    { "family": "Zen Kaku Gothic New", "weights": [400], "use": "日文原句、今日のセリフ 標記", "license": "SIL Open Font License 1.1" }
  ]
}
